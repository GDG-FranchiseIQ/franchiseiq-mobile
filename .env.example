# Copy to .env — used by app.config.js via expo-constants extra
# Leave API/WS empty for offline dev (mock project + session). Set real Cloud Run URLs when backend exists.
EXPO_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_WS_BASE_URL=
EXPO_PUBLIC_WEB_DASHBOARD_URL=https://your-firebase-hosting.web.app
EXPO_PUBLIC_USE_MOCK_WS=true

# Firebase (client) — replace with your Firebase web app config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
